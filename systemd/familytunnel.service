[Unit]
Description=FamilyTunnel controller
After=network-online.target wg-quick@ft0.service familytunnel-firewall.service
Wants=network-online.target
Requires=wg-quick@ft0.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/familytunnel serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/familytunnel /run/lock -/run/xtables.lock -/proc/sys/net/ipv4/ip_forward
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
MemoryMax=384M
TasksMax=100
LimitNOFILE=8192
TimeoutStopSec=25
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
